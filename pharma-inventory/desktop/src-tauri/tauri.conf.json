{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Agro Kendra IMS",
  "version": "1.0.0",
  "identifier": "com.agrokendra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agro Kendra IMS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://ims-software-one-theta.vercel.app http://localhost:3001; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:pharma.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCN0Q4OURFNzg4RjkzRjEKUldUeGs0OTQzb2w5YTVQK000Z3p6bTVWV3JQWXpJRzNWYWZ5WmQ3NzEvL0VRYUtFMjY1YVhaUjgK",
      "endpoints": [
        "https://ims-software-one-theta.vercel.app/api/updates?target={{target}}&current_version={{current_version}}&product=agro",
        "https://github.com/1001av/IMS-Software/releases/latest/download/latest-agro.json"
      ],
      "dangerousInsecureTransport": true
    }
  }
}